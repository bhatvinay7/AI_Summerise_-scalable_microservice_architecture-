FROM node:latest AS base
ENV PATH=/app/node_modules/.bin:$PATH
RUN npm install -g pnpm turbo

FROM base AS prunner
ARG APP=web
WORKDIR /app
COPY . .
RUN turbo prune --scope=$APP --docker


FROM base AS installer
ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}
ENV NEXT_PUBLIC_FRONTEND_URL=${NEXT_PUBLIC_FRONTEND_URL}
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_WEBSOCKET_SERVER=${secrets.NEXT_PUBLIC_WEBSOCKET_SERVER}
ENV ACCESS_TOKEN_SECRET=${ACCESS_TOKEN_SECRET}
ENV REFRESH_TOKEN_SECRET=${secrets.REFRESH_TOKEN_SECRET}
ARG APP=web
WORKDIR /app
COPY --from=prunner /app/out/json/ .
COPY --from=prunner /app/out/full/ .
COPY package.json  ./
COPY apps/${APP}/package.json ./apps/${APP}/
COPY pnpm-lock.yaml ./
COPY  pnpm-workspace.yaml ./
COPY .npmrc ./
COPY packages/ ./packages/
RUN pnpm install
RUN pnpm --filter  prisma run generate

FROM base AS  builder
WORKDIR /app
COPY --from=installer /app ./
COPY --from=installer /app/node_modules ./node_modules
WORKDIR /app/apps/web
RUN pnpm run build
FROM base AS runner
WORKDIR /app
COPY --from=builder /app ./
COPY --from=builder app/node_modules ./node_modules
COPY --from=builder /app/apps/web/.next/ ./apps/web/.next/
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
WORKDIR /app/apps/web
CMD ["pnpm","run","start"]