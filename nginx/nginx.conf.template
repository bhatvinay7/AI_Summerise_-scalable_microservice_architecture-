# Redirect all HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN} ${FRONTEND_DOMAIN} ${WS_SERVER_DOMAIN} ${DOMAIN};
    return 301 https://$host$request_uri;
}

# API Server
server {
    server_name ${API_DOMAIN};

    

    location / {
        proxy_pass  http://${API_DOMAIN}:${API_DOMAIN_PORT}; # http-server container
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Web App (Frontend)
server {
    
    server_name ${FRONTEND_DOMAIN};

    

    location / {
        proxy_pass http://${FRONTEND_DOMAIN}:${FRONTEND_DOMAIN_PORT};   # web container
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "keep-alive";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# WebSocket Server
server {
    server_name ${WS_SERVER_DOMAIN};

    

    location / {
        proxy_pass http://${WS_SERVER_DOMAIN}:${WS_SERVER_DOMAIN_PORT};   # ws-server container
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
