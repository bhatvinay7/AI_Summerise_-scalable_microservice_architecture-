# Redirect all HTTP to HTTPS (for future SSL)


# Frontend HTTP

server {
    listen 80;
    listen [::]:80;
    server_name ${FRONTEND_DOMAIN};


    location / {
        proxy_pass http://${FRONTEND_DOMAIN}:${FRONTEND_DOMAIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "keep-alive";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


# API HTTP
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};
    location / {
        proxy_pass http://${API_DOMAIN}:${API_DOMAIN_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


# WebSocket HTTP

server {
    listen 80;
    listen [::]:80;
    server_name ${WS_SERVER_DOMAIN};
   
    location / {
        proxy_pass http://${WS_SERVER_DOMAIN}:${WS_SERVER_DOMAIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme; 
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}



